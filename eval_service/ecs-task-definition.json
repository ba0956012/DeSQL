{
  "family": "text-to-sql-benchmark",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "taskRoleArn": "arn:aws:iam::781160412246:role/AIOT-VannaECSTaskRole",
  "executionRoleArn": "arn:aws:iam::781160412246:role/AIOT-VannaECSTaskRole",
  "containerDefinitions": [
    {
      "name": "aiot-text-to-sql-benchmark",
      "image": "781160412246.dkr.ecr.ap-northeast-1.amazonaws.com/aiot/text-to-sql-benchmark:latest",
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "AZURE_OPENAI_API_KEY",
          "value": "cb35419c2af741e9870b574499344e99"
        },
        {
          "name": "AZURE_OPENAI_ENDPOINT",
          "value": "https://cog-arir2ytlocdly.openai.azure.com"
        },
        {
          "name": "OPENAI_API_VERSION",
          "value": "2024-12-01-preview"
        },
        {
          "name": "LLM_MODEL",
          "value": "gpt-4.1-mini"
        },
        {
          "name": "LLM_DEPLOYMENT",
          "value": "gpt-4.1-mini"
        },
        {
          "name": "LLM_TEMPERATURE",
          "value": "0"
        },
        {
          "name": "DATA_DIR",
          "value": "/app/data"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/text-to-sql-benchmark",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8080/health')\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    },
    {
      "name": "chart-service",
      "image": "781160412246.dkr.ecr.ap-northeast-1.amazonaws.com/aiot/chart-service:latest",
      "portMappings": [
        {
          "containerPort": 8081,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "AZURE_OPENAI_API_KEY",
          "value": "cb35419c2af741e9870b574499344e99"
        },
        {
          "name": "AZURE_OPENAI_ENDPOINT",
          "value": "https://cog-arir2ytlocdly.openai.azure.com"
        },
        {
          "name": "OPENAI_API_VERSION",
          "value": "2024-12-01-preview"
        },
        {
          "name": "LLM_MODEL",
          "value": "gpt-4.1-mini"
        },
        {
          "name": "LLM_DEPLOYMENT",
          "value": "gpt-4.1-mini"
        },
        {
          "name": "LLM_TEMPERATURE",
          "value": "0"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/text-to-sql-benchmark",
          "awslogs-region": "ap-northeast-1",
          "awslogs-stream-prefix": "ecs-chart",
          "awslogs-create-group": "true"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8081/health')\""],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      }
    }
  ]
}
